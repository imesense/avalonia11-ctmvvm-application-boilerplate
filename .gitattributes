# Global attributes for forcing line endings normalization of specific files

* text=auto

# Text files
*.txt text eol=crlf encoding=utf-8

# Image files
*.ico binary
*.png binary
*.icns binary

# Markdown files
*.md text eol=crlf encoding=utf-8

# Windows files
*.manifest text eol=crlf encoding=utf-8

# Apple files
*.plist text eol=lf encoding=utf-8
*.xib text eol=lf encoding=utf-8

# XML files
*.xml text eol=crlf encoding=utf-8

# JSON files
*.json text eol=crlf encoding=utf-8

# HTML files
*.htm text eol=crlf encoding=utf-8
*.html text eol=crlf encoding=utf-8

# CSS files
*.css text eol=crlf encoding=utf-8

# JavaScript files
*.js text eol=crlf encoding=utf-8

# XAML files
*.xaml text eol=crlf encoding=utf-8
*.axaml text eol=crlf encoding=utf-8

# MSBuild files
*.sln text eol=crlf encoding=utf-8-bom
*.slnx text eol=crlf encoding=utf-8
*.slnf text eol=crlf encoding=utf-8
*.csproj text eol=crlf encoding=utf-8
*.props text eol=crlf encoding=utf-8
*.targets text eol=crlf encoding=utf-8

# CSharp files
*.cs text eol=crlf encoding=utf-8

# DotNet files
*.resx text eol=crlf encoding=utf-8
*.settings text eol=crlf encoding=utf-8
global.json text eol=crlf encoding=utf-8
dotnet-tools.json text eol=crlf encoding=utf-8

# Git files
.gitattributes text eol=lf encoding=utf-8
.gitignore text eol=lf encoding=utf-8

# EditorConfig files
.editorconfig text eol=crlf encoding=utf-8

# NuGet files
NuGet.config text eol=crlf encoding=utf-8

# Web files
src/**/wwwroot/** -linguist-detectable
