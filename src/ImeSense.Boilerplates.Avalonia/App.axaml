<Application
    x:Class="ImeSense.Boilerplates.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dt="using:ImeSense.Boilerplates.Avalonia.DataTemplates"
    RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <dt:ViewDataTemplate />
    </Application.DataTemplates>

    <Application.Styles>
        <SimpleTheme />
    </Application.Styles>
</Application>
